{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BitBurner append-only approval record",
  "oneOf": [
    {
      "type": "object",
      "required": ["recordType", "schemaVersion", "createdAt", "purpose"],
      "properties": {
        "recordType": {"const": "ledger-init"},
        "schemaVersion": {"const": 1},
        "createdAt": {"type": "string"},
        "purpose": {"type": "string"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["recordType", "schemaVersion", "approvalId", "status", "approvedBy", "recordedBy", "recordedAt", "scope", "riskTier", "action", "limits", "stopConditions", "rollback", "evidencePath", "independentDecision", "expiresAt", "supersedes"],
      "properties": {
        "recordType": {"const": "approval"},
        "schemaVersion": {"const": 1},
        "approvalId": {"type": "string", "pattern": "^APR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
        "status": {"enum": ["active", "revoked", "expired", "consumed"]},
        "approvedBy": {"type": "string"},
        "recordedBy": {"type": "string"},
        "recordedAt": {"type": "string"},
        "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "riskTier": {"const": 3},
        "action": {"type": "string"},
        "limits": {"type": "object"},
        "stopConditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rollback": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidencePath": {"type": "string"},
        "independentDecision": {"enum": ["ADOPT", "KEEP", "REVISE", "REJECT"]},
        "expiresAt": {"type": ["string", "null"]},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  ]
}
