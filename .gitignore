mcp_formulas_shadow.txt
ipvgo_status.json
dnet_status.json
dnet_scorecard_status.json
dnet_killswarm_status.json

# Darknet credential store — game output, and it holds cracked passwords.
dnet_creds.txt
dnet_cred_*.txt

# macOS
.DS_Store

# Claude Code local state (permissions, worktrees) — machine-local, not repo content
.claude/

# Python cache
__pycache__/
*.pyc

# Node modules (if added later)
node_modules/

# VS Code workspace settings
.vscode/

# Out-of-game triggers (generated)
mcp_restart.txt
mcp_dump_request.txt
mcp_objective_override.txt

# tools/bb_remote.py's connection-event diagnostic log (generated, local),
# and the nohup stdout redirect used to run `daemon` detached — same
# content, different file, both generated at runtime, neither hand-authored
tools/bb_remote_events.log
tools/bb_remote_daemon.out

# Generated local governance-auditor heartbeat and logs
.audit/

# Bitburner save-file snapshots synced from the game (saves/tsconfig.json
# stays tracked regardless — it's hand-authored, not game output)
saves/*.json.gz
