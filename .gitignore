# Generated Bitburner status files. Note mcp_config.json is deliberately NOT
# here — it is an input we author, and it must be in the repo to sync into
# the game.
mcp_status.json
mcp_status_log.txt
mcp_target_state.json
mcp_events.txt

# Darknet credential store — game output, and it holds cracked passwords.
dnet_creds.txt
dnet_cred_*.txt

# macOS
.DS_Store

# Python cache
__pycache__/
*.pyc

# Node modules (if added later)
node_modules/

# VS Code workspace settings
.vscode/

# Out-of-game triggers (generated)
mcp_restart.txt
mcp_dump_request.txt

# Bitburner save-file snapshots synced from the game (saves/tsconfig.json
# stays tracked regardless — it's hand-authored, not game output)
saves/*.json.gz
